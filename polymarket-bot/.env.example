# Polymarket Trading Bot - Environment Variables
# Copy this file to .env and fill in your values.

# === Polymarket API ===
POLYMARKET_API_KEY=
POLYMARKET_SECRET=
POLYMARKET_PASSPHRASE=

# === Binance API (for price feeds) ===
BINANCE_API_KEY=
BINANCE_SECRET=

# === Coinbase API (for price feeds) ===
COINBASE_API_KEY=
COINBASE_SECRET=

# === WebSocket Configuration ===
# WS_NUM_CONNECTIONS=6
# WS_RESPAWN_RATE_MS=500
# WS_JITTER_THRESHOLD_MS=50
# WS_RECONNECT_DELAY_S=1.0
# WS_MAX_RECONNECT_DELAY_S=60.0
# WS_PING_INTERVAL_S=30.0

# === Trading Parameters ===
# TRADING_MAX_PRICE=0.95
# TRADING_MIN_PRICE=0.05
# TRADING_STOP_LOSS_PCT=0.10
# TRADING_MAX_POSITION=100.0
# TRADING_MAX_OPEN_POSITIONS=10

# === Data Storage ===
# DATA_STORAGE_PATH=data/
# DATA_DB_PATH=data/market_data.db
# DATA_RECORD_RAW=true

# === Logging ===
# LOG_LEVEL=INFO
# LOG_FORMAT=json
# LOG_FILE_PATH=

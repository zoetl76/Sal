# ─── Telegram Bot ───────────────────────────────────────────
TELEGRAM_BOT_TOKEN=7xxxxxxxxx:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MINI_APP_URL=https://your-frontend.vercel.app

# ─── Oracle / Smart Contract ─────────────────────────────────
ORACLE_PRIVATE_KEY=0xabc...               # Clé privée du compte oracle
CONTRACT_ADDRESS=0x...                    # Adresse après déploiement
TREASURY_ADDRESS=0x...                    # Adresse de réception des frais

# ─── Polygon ─────────────────────────────────────────────────
POLYGON_RPC_URL=https://polygon-rpc.com
DEPLOYER_PRIVATE_KEY=0xabc...             # Clé pour déployer le contrat
POLYGONSCAN_API_KEY=xxx                   # Pour vérifier le contrat

# ─── API Backend ─────────────────────────────────────────────
PORT=8000
API_URL=http://localhost:8000             # URL de l'oracle (frontend)

# ─── Frontend ────────────────────────────────────────────────
VITE_CONTRACT_ADDRESS=0x...              # Copié depuis contract/
VITE_API_URL=https://your-api.railway.app

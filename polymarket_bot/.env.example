# Polymarket Bot Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# WALLET & AUTHENTICATION
# =============================================================================
# Your Polygon wallet private key (with 0x prefix)
PRIVATE_KEY=0x_your_private_key_here

# Your deposit wallet address (funder address for orders)
DEPOSIT_WALLET_ADDRESS=0x_your_deposit_wallet_address

# Signature type: 0=EOA, 1=POLY_PROXY, 2=GNOSIS_SAFE, 3=POLY_1271 (deposit wallet)
SIGNATURE_TYPE=3

# API credentials (derived from private key via L1 auth)
# Leave empty to auto-derive on first run
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_API_PASSPHRASE=

# =============================================================================
# API ENDPOINTS
# =============================================================================
CLOB_API_URL=https://clob.polymarket.com
GAMMA_API_URL=https://gamma-api.polymarket.com
DATA_API_URL=https://data-api.polymarket.com

# Chain ID (137 = Polygon Mainnet)
CHAIN_ID=137

# =============================================================================
# TRADING STRATEGY
# =============================================================================
# Strategy: value, momentum, mean_reversion, arbitrage
STRATEGY=value

# Maximum number of markets to trade simultaneously
MAX_ACTIVE_MARKETS=5

# Minimum liquidity (in pUSD) required to consider a market
MIN_LIQUIDITY=1000

# Minimum spread to enter a position (e.g., 0.05 = 5% edge)
MIN_EDGE=0.05

# Order size in pUSD per trade
ORDER_SIZE=10

# Maximum position size per market (in pUSD)
MAX_POSITION_SIZE=100

# =============================================================================
# RISK MANAGEMENT
# =============================================================================
# Maximum total portfolio exposure (in pUSD)
MAX_TOTAL_EXPOSURE=500

# Stop loss percentage (e.g., 0.15 = 15% loss triggers exit)
STOP_LOSS=0.15

# Take profit percentage (e.g., 0.30 = 30% profit triggers exit)
TAKE_PROFIT=0.30

# Maximum number of open orders
MAX_OPEN_ORDERS=20

# Daily loss limit in pUSD (bot stops trading if hit)
DAILY_LOSS_LIMIT=50

# =============================================================================
# BOT SETTINGS
# =============================================================================
# Trading loop interval in seconds
LOOP_INTERVAL=60

# Enable paper trading mode (no real orders placed)
PAPER_TRADING=true

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Enable Telegram notifications
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
